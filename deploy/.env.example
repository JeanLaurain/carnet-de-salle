# Copier ce fichier dans DEPLOY_DIR/.env sur le NAS (ex. /volume1/docker/carnet-de-salle/.env)
# puis remplacer toutes les valeurs. Ne jamais le committer.

# Domaine public (choisir avant d'activer les passkeys : une passkey est liée au domaine)
APP_DOMAIN=fitness.jeanlaura.in

# Dossier des données persistantes sur le NAS
DATA_DIR=/volume1/docker/carnet-de-salle/data

# Port local du conteneur web, cible du reverse proxy DSM (http://localhost:8380)
WEB_PORT=8380

# Version à déployer. Vide : update.sh suit la dernière publication réussie de main.
# Une valeur comme sha-1a2b3c4 fige cette version (pratique pour revenir en arrière).
IMAGE_TAG=

# Seulement si le dépôt ou les images sont privés : jeton GitHub « fine-grained » en lecture
# (Contents : Read-only sur le dépôt, et packages en lecture pour ghcr.io). Vide si tout est public.
GITHUB_USER=JeanLaurain
GITHUB_TOKEN=

# SQL Server : 8 caractères minimum, majuscule, minuscule, chiffre et symbole.
# Évite les espaces et les caractères $ ' " et ` dans les mots de passe (ils gênent docker compose,
# bash et sqlcmd).
MSSQL_SA_PASSWORD=change-me-Sa#2026
MSSQL_MEMORY_LIMIT_MB=1536
DB_NAME=CarnetDeSalle

# Image SQL Server. Vide : SQL Server 2022 (mcr.microsoft.com/mssql/server:2022-latest), la seule qui
# démarre sur le NAS (la 2025 plante au lancement). Passer en 2025 plus tard convertit la base
# sans retour possible : tester d'abord (docs/deploiement-nas.md, étape 1) et sauvegarder.
MSSQL_IMAGE=

# Compte SQL utilisé par l'API (créé par deploy/sql/init-db.sql, droits limités)
DB_APP_USER=carnet_app
DB_APP_PASSWORD=change-me-App#2026

# Emails autorisés à se connecter, séparés par des virgules (appli privée)
AUTH_ALLOWED_EMAILS=toi@example.com

# Connexion Google : ID client OAuth « Application Web » (docs/authentification.md)
GOOGLE_CLIENT_ID=

# Connexion Apple : Services ID (nécessite l'Apple Developer Program)
APPLE_SERVICES_ID=

# Claude dans l'appli (docs/claude.md), facultatif
ANTHROPIC_API_KEY=
