<?xml version="1.0" encoding="utf-8"?>
<!-- Sources NuGet du projet : uniquement nuget.org.
     <clear /> ignore les flux configurés sur le poste (ex. un flux Azure DevOps privé du travail),
     pour que la restauration marche partout de la même façon : PC, CI et Docker. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
